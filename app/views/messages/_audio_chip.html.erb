<%# Shared audio chip (PM12-S1 → PM16-C). Markup contract mirrors
    app/javascript/lib/audio_chip.js: .audio-chip > .audio-chip__play +
    .audio-chip__duration + canvas.audio-chip__wave + .audio-chip__transcript.
    No filename (PM16-C). The transcript slot ships EMPTY by default — the PM12
    plugin slice fills it after gateway STT. Do not render STT text here. %>
<div class="audio-chip flex flex--align-center gap-half" data-controller="audio-chip" data-audio-chip-src-value="<%= rails_blob_path(message.attachment) %>">
  <button type="button" class="btn btn--plain audio-chip__play flex-item-no-shrink" data-action="audio-chip#toggle" aria-label="Play audio">
    <%= image_tag "play.svg", size: 18, class: "colorize--black", aria: { hidden: "true" } %>
  </button>
  <canvas class="audio-chip__wave flex-item-no-shrink" data-audio-chip-target="wave" data-action="click->audio-chip#seek" role="img" aria-label="Waveform, click to seek"></canvas>
  <span class="audio-chip__duration txt-small flex-item-no-shrink" data-audio-chip-target="duration"></span>
  <span class="audio-chip__transcript"><%= transcript %></span>
</div>
