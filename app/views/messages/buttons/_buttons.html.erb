<% if message.message_buttons.any? %>
  <div class="flex-inline flex-wrap gap" id="<%= dom_id(message, :buttons) %>" style="--column-gap: 0.4ch">
    <% message.message_buttons.ordered.each do |button| %>
      <%= tag.button type: "button",
            id: dom_id(button),
            class: "boost__action txt-small btn",
            title: button.label,
            aria: { label: button.label },
            data: { controller: "button-click", button_click_url_value: message_button_click_path(message, button),
                    action: "button-click#click" } do %>
        <%= image_tag button.icon_name, size: 20, class: "colorize--black", aria: { hidden: "true" } %>
        <span class="for-screen-reader"><%= button.label %></span>
      <% end %>
    <% end %>
  </div>
<% end %>
